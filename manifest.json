{
  "schemaVersion": 1,
  "id": "pablousx.relai",
  "name": "Relai",
  "version": "1.0.0",
  "author": "pablousx",
  "license": "MIT",
  "description": "Your AI setup, relayed everywhere. Global configuration sync for Codex, Claude Code and OpenCode.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "qml/Relai.qml"
  },
  "barWidget": {
    "displayName": "Relai",
    "description": "AI configuration sync health, providers, machines, conflicts and recovery.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshSeconds": 3
    },
    "schema": [
      {
        "key": "refreshSeconds",
        "type": "integer",
        "label": "Status refresh (seconds)",
        "min": 2,
        "max": 60,
        "defaultValue": 3
      }
    ]
  }
}
