#!/bin/sh
set -eu
omai_data="${XDG_DATA_HOME:-$HOME/.local/share}/omai"
if [ -x "$omai_data/bin/omai" ]; then
  exec "$omai_data/bin/omai" "$@"
fi
if [ "${1:-}" = status ]; then
  printf '%s\n' '{"version":"1.0.0","health":"setup","configured":false,"daemon":false,"providers":[],"machines":[],"conflicts":[],"warnings":[]}'
  exit 0
fi
printf '%s\n' 'omai needs first-run setup. Open its bar panel and choose Set up omai.' >&2
exit 1
