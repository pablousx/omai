#!/bin/bash
# Noninteractive bridge used by the plugin's setup form and update button.
set -euo pipefail
relai_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
relai_mode=${1:-}
shift || true
[[ $relai_mode == setup || $relai_mode == update ]] || { printf '%s\n' 'Expected setup or update.' >&2; exit 1; }
relai_source=()
if [[ ${1:-} == --source ]]; then relai_source=(--source); shift; fi
relai_binary="${XDG_DATA_HOME:-$HOME/.local/share}/relai/bin/relai"
command -v python3 >/dev/null || { printf '%s\n' 'Python 3 is required to install Relai.' >&2; exit 1; }
relai_version=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$relai_root/manifest.json")
relai_installed=$("$relai_binary" version 2>/dev/null || true)
if [[ $relai_mode == update || $relai_installed != "$relai_version" || ${#relai_source[@]} -gt 0 ]]; then
  printf '%s\n' 'Preparing Relai…'
  "$relai_root/scripts/setup" --install-only "${relai_source[@]}"
fi
if [[ $relai_mode == setup ]]; then
  for relai_command in git systemctl; do
    command -v "$relai_command" >/dev/null || { printf 'Setup requires %s.\n' "$relai_command" >&2; exit 1; }
  done
  printf '%s\n' 'Saving configuration and starting sync…'
  "$relai_binary" setup --yes "$@"
  printf '%s\n' 'Setup complete.'
else
  printf '%s\n' 'Relai is up to date.'
fi
