#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
python3 scripts/check-release.py
[[ -z $(gofmt -l cmd internal) ]] || { printf '%s\n' 'Go files need formatting.' >&2; exit 1; }
go test -race ./...
go vet ./...
bash -n scripts/setup scripts/plugin-setup scripts/terminal scripts/check
sh -n scripts/relai
if command -v shellcheck >/dev/null; then shellcheck scripts/setup scripts/plugin-setup scripts/terminal scripts/check scripts/relai; fi
if command -v actionlint >/dev/null; then actionlint -config-file .github/actionlint.yaml .github/workflows/ci.yml .github/workflows/release.yml; fi
go build -buildvcs=false -mod=readonly -trimpath -o build/relai ./cmd/relai
python3 scripts/test-e2e.py build/relai
python3 scripts/test-install.py build/relai
python3 scripts/check-release.py --binary build/relai
if command -v omarchy >/dev/null; then omarchy plugin validate .; fi
