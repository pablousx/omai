#!/bin/sh
set -eu
relai_data="${XDG_DATA_HOME:-$HOME/.local/share}/relai"
if [ -x "$relai_data/bin/relai" ]; then
  exec "$relai_data/bin/relai" "$@"
fi
if [ "${1:-}" = status ]; then
  printf '%s\n' '{"version":"1.0.0","health":"setup","configured":false,"daemon":false,"providers":[],"machines":[],"conflicts":[],"warnings":[]}'
  exit 0
fi
printf '%s\n' 'Relai needs first-run setup. Open its bar panel and choose Set up Relai.' >&2
exit 1
